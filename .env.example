# ──────────────────────────────────────────────────────────────────
# Astro frontend — environment variables
# ──────────────────────────────────────────────────────────────────
#
# IMPORTANT: Astro is a frontend-only app. It does NOT store data or
# run business logic locally. All auth, properties, tenant admin,
# inquiries, and content are loaded from the **external** Hono API
# in the `server/` directory (or your deployed Workers URL).
#
# Production API (external Hono backend). For local API dev, override with:
# PUBLIC_API_BASE_URL=http://localhost:3000
PUBLIC_API_BASE_URL=https://api.topvillaluxuryhome.com.ng
