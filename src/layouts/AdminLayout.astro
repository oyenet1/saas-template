---
import '../styles/global.css';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import ExternalApiNotice from '../components/ExternalApiNotice.vue';

export interface Props {
  title?: string;
  description?: string;
}

const { title = 'Admin — Top Villa', description = 'Manage your real estate company' } = Astro.props;

interface SidebarLink {
  href: string;
  label: string;
  icon: string;
  section?: string;
}

const sidebarLinks: SidebarLink[] = [
  { href: '/admin', label: 'Overview', icon: 'i-lucide-layout-dashboard', section: 'Main' },
  { href: '/admin/properties', label: 'Properties', icon: 'i-lucide-building-2', section: 'Main' },
  { href: '/admin/categories', label: 'Categories', icon: 'i-lucide-tags', section: 'Catalog' },
  { href: '/admin/features', label: 'Features', icon: 'i-lucide-sparkles', section: 'Catalog' },
  { href: '/admin/inquiries', label: 'Inquiries', icon: 'i-lucide-mail', section: 'Leads' },
  { href: '/admin/content/banners', label: 'Banners', icon: 'i-lucide-image', section: 'Content' },
  { href: '/admin/content/blogs', label: 'Blog Posts', icon: 'i-lucide-newspaper', section: 'Content' },
  { href: '/admin/content/faqs', label: 'FAQs', icon: 'i-lucide-help-circle', section: 'Content' },
  { href: '/admin/content/team', label: 'Team', icon: 'i-lucide-users', section: 'Content' },
  { href: '/admin/content/testimonies', label: 'Testimonials', icon: 'i-lucide-message-square-quote', section: 'Content' },
  { href: '/admin/content/services', label: 'Services', icon: 'i-lucide-briefcase', section: 'Content' },
  { href: '/admin/members', label: 'Staff', icon: 'i-lucide-user-cog', section: 'Company' },
  { href: '/admin/company', label: 'Company Settings', icon: 'i-lucide-settings', section: 'Company' },
];

const currentPath = Astro.url.pathname;

const sections = [...new Set(sidebarLinks.map((l) => l.section ?? 'Main'))];
---

<!doctype html>
<html lang="en" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      (function() {
        var theme = localStorage.getItem('vueuse-color-scheme');
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
          document.documentElement.classList.remove('light');
        } else {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
        }
      })();
    </script>
  </head>
  <body class="isolate bg-[var(--surface-muted)] text-default">
    <Navbar />
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="flex gap-8">
        <aside class="hidden lg:block w-64 shrink-0">
          <nav class="sticky top-24 space-y-6">
            {
              sections.map((section) => (
                <div>
                  <p class="text-xs font-semibold text-muted uppercase tracking-wider px-3 mb-2">{section}</p>
                  <div class="space-y-0.5">
                    {sidebarLinks
                      .filter((link) => (link.section ?? 'Main') === section)
                      .map((link) => {
                        const isActive =
                          currentPath === link.href ||
                          (link.href !== '/admin' && currentPath.startsWith(link.href));
                        return (
                          <a
                            href={link.href}
                            class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${
                              isActive
                                ? 'bg-primary/10 text-primary'
                                : 'text-muted hover:text-default hover:bg-elevated'
                            }`}
                          >
                            <span class={`${link.icon} size-4 shrink-0`} />
                            <span>{link.label}</span>
                          </a>
                        );
                      })}
                  </div>
                </div>
              ))
            }
            <a
              href="/dashboard"
              class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-muted hover:text-default hover:bg-elevated transition-colors"
            >
              <span class="i-lucide-user size-4 shrink-0" />
              <span>My Account</span>
            </a>
          </nav>
        </aside>
        <main class="flex-1 min-w-0">
          <ExternalApiNotice client:load />
          <slot />
        </main>
      </div>
    </div>
    <Footer />
  </body>
</html>
