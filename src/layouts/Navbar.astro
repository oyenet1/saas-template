---
import DarkModeToggle from '../components/DarkModeToggle.vue';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/properties', label: 'Properties' },
  { href: '/dashboard', label: 'Dashboard' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const currentPath = Astro.url.pathname;
---

<nav class="sticky top-0 z-50 border-b border-[var(--surface-border)] bg-white/90 dark:bg-[var(--surface-page)]/90 backdrop-blur-xl shadow-[var(--shadow-nav)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-[4.25rem]">
      <a href="/" class="flex items-center gap-2.5 shrink-0 group">
        <span class="flex items-center justify-center w-9 h-9 rounded-xl bg-primary/10 text-primary transition-transform group-hover:scale-105">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </span>
        <span class="text-xl font-semibold tracking-tight font-[family-name:var(--font-display)]">
          Lux<span class="text-primary">Estate</span>
        </span>
      </a>

      <div class="hidden md:flex items-center gap-1">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-4 py-2 rounded-lg text-sm font-medium transition-all ${
                isActive
                  ? 'text-primary bg-primary/8'
                  : 'text-muted hover:text-default hover:bg-[var(--surface-muted)]'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </div>

      <div class="flex items-center gap-2">
        <a href="/properties" class="hidden sm:inline-flex btn-primary !py-2 !px-4 !text-xs">
          Browse Listings
        </a>
        <DarkModeToggle client:only="vue" />
        <div class="md:hidden">
          <button
            type="button"
            class="p-2.5 rounded-xl text-muted hover:text-default hover:bg-[var(--surface-muted)] transition-colors"
            aria-label="Toggle menu"
            onclick="document.getElementById('mobile-menu')?.classList.toggle('hidden')"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
          </button>
        </div>
      </div>
    </div>

    <div id="mobile-menu" class="hidden md:hidden border-t border-[var(--surface-border)] pb-4 pt-2 space-y-1">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`block px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${
              isActive
                ? 'text-primary bg-primary/10'
                : 'text-muted hover:text-default hover:bg-[var(--surface-muted)]'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </div>
  </div>
</nav>
