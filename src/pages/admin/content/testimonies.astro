---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import ContentManager from '../../../components/admin/ContentManager.vue';

const testimonyFields = [
  { key: 'name', label: 'Client name', type: 'text', required: true },
  { key: 'content', label: 'Testimonial', type: 'textarea', required: true },
  { key: 'rating', label: 'Rating (1–5)', type: 'number' },
  { key: 'photoUrl', label: 'Photo URL', type: 'url' },
  { key: 'location', label: 'Location', type: 'text' },
  { key: 'sortOrder', label: 'Sort order', type: 'number' },
  { key: 'isActive', label: 'Active', type: 'boolean' },
];
---

<AdminLayout title="Testimonials — Admin" description="Client testimonials">
  <div class="mb-8">
    <h1 class="text-2xl font-bold">Testimonials</h1>
    <p class="text-muted text-sm mt-1">Social proof from satisfied clients.</p>
  </div>
  <ContentManager
      client:load
      resource="testimonies"
      collection-key="testimonies"
      singular-key="testimony"
      title="Testimonials"
      fields={testimonyFields}
    />
</AdminLayout>
