---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import ContentManager from '../../../components/admin/ContentManager.vue';

const teamFields = [
  { key: 'name', label: 'Name', type: 'text', required: true },
  { key: 'role', label: 'Role / title', type: 'text' },
  { key: 'bio', label: 'Bio', type: 'textarea' },
  { key: 'photoUrl', label: 'Photo URL', type: 'url' },
  { key: 'email', label: 'Email', type: 'text' },
  { key: 'phone', label: 'Phone', type: 'text' },
  { key: 'sortOrder', label: 'Sort order', type: 'number' },
  { key: 'isActive', label: 'Active', type: 'boolean' },
];
---

<AdminLayout title="Team — Admin" description="Team members">
  <div class="mb-8">
    <h1 class="text-2xl font-bold">Team</h1>
    <p class="text-muted text-sm mt-1">Agents and staff shown on your public site.</p>
  </div>
  <ContentManager
      client:load
      resource="teams"
      collection-key="teams"
      singular-key="team"
      title="Team"
      fields={teamFields}
    />
</AdminLayout>
