---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import PropertyForm from '../../../components/admin/PropertyForm.vue';
---

<AdminLayout title="New property — Admin" description="Create a property listing">
  <div class="mb-8">
    <h1 class="text-2xl font-bold">New property</h1>
    <p class="text-muted text-sm mt-1">Add a listing with location, pricing, and features.</p>
