---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import PropertyForm from '../../../components/admin/PropertyForm.vue';

const id = Number.parseInt(Astro.params.id ?? '', 10);
if (!Number.isFinite(id)) return Astro.redirect('/admin/properties');
---

<AdminLayout title="Edit property — Admin" description="Update property listing">
  <div class="mb-8">
    <h1 class="text-2xl font-bold">Edit property</h1>
    <p class="text-muted text-sm mt-1">Update listing details, location, and publish status.</p>
  </div>
  <PropertyForm client:load propertyId={id} />
</AdminLayout>
