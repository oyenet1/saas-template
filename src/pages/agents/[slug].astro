---
import Layout from '../../layouts/Layout.astro';
import InquiryForm from '../../components/InquiryForm.vue';
import { getAgentBySlug, getFeaturedAgents } from '../../lib/api';
import type { Agent } from '../../lib/api';

const { slug } = Astro.params;
const agent: Agent | undefined = slug ? await getAgentBySlug(slug) : undefined;

if (!agent) {
  return Astro.redirect('/agents');
}

const featuredAgents = await getFeaturedAgents();
const similar = featuredAgents.filter((a: Agent) => a.slug !== slug).slice(0, 3);
---

<Layout
  title={`${agent.name} \u2014 LuxEstate Agent`}
  description={`${agent.name} \u2014 ${agent.title} at LuxEstate. ${agent.propertiesSold}+ properties sold, ${agent.experience} years experience.`}
>
  <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav class="flex items-center gap-2 text-sm text-muted mb-6">
      <a href="/" class="hover:text-default transition-colors">Home</a>
      <span>/</span>
      <a href="/agents" class="hover:text-default transition-colors">Agents</a>
      <span>/</span>
      <span class="text-default">{agent.name}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      <div class="lg:col-span-1">
        <div class="sticky top-28 space-y-6">
          <div class="relative aspect-[3/4] rounded-xl overflow-hidden">
            <img
              src={agent.imageUrl}
              alt={agent.name}
              class="w-full h-full object-cover"
              loading="eager"
            />
            {agent.featured && (
              <div class="absolute top-4 left-4">
                <span class="px-3 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wide bg-primary text-white shadow-sm">
                  Featured Agent
                </span>
              </div>
            )}
          </div>

          <div class="p-5 rounded-xl border border-[var(--surface-border)] surface-card space-y-4">
            <div>
              <h3 class="font-semibold text-sm mb-1">Contact</h3>
              <a href={`tel:${agent.phone}`} class="block text-sm text-muted hover:text-primary transition-colors">{agent.phone}</a>
              <a href={`mailto:${agent.email}`} class="block text-sm text-muted hover:text-primary transition-colors">{agent.email}</a>
            </div>
            <div class="flex items-center gap-1">
              {Array.from({ length: agent.rating }, (_, i) => (
                <svg key={i} xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-amber-400"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              ))}
              <span class="text-xs text-muted ml-1">{agent.rating}.0</span>
            </div>
            <div class="grid grid-cols-2 gap-3 text-center">
              <div class="p-3 rounded-lg border border-[var(--surface-border)]">
                <p class="text-xl font-bold text-primary">{agent.propertiesSold}</p>
                <p class="text-xs text-muted">Properties Sold</p>
              </div>
              <div class="p-3 rounded-lg border border-[var(--surface-border)]">
                <p class="text-xl font-bold text-primary">{agent.experience}</p>
                <p class="text-xs text-muted">Years Experience</p>
              </div>
            </div>
            <a href={`/contact?agent=${agent.slug}`} class="block w-full btn-primary justify-center text-center">
              Contact {agent.name.split(' ')[0]}
            </a>
          </div>
        </div>
      </div>

      <div class="lg:col-span-2 space-y-8">
        <div>
          <div class="flex flex-wrap items-start justify-between gap-2">
            <div>
              <span class="badge-soft mb-3 inline-block">{agent.title}</span>
              <h1 class="text-4xl font-semibold tracking-tight">{agent.name}</h1>
            </div>
          </div>
          <p class="mt-6 text-muted leading-relaxed text-lg">{agent.bio}</p>
        </div>

        <div>
          <h2 class="text-xl font-semibold mb-4">Specialties</h2>
          <div class="flex flex-wrap gap-2">
            {agent.specialties.map((s) => (
              <span class="px-3 py-1.5 rounded-lg text-sm font-medium bg-primary/10 text-primary border border-primary/20">{s}</span>
            ))}
          </div>
        </div>

        <div class="surface-card p-6">
          <h2 class="text-xl font-semibold mb-4">Send a Message</h2>
          <InquiryForm client:load propertyTitle={agent.name} />
        </div>
      </div>
    </div>

    {similar.length > 0 && (
      <section class="mt-16 pt-12 border-t border-[var(--surface-border)]">
        <h2 class="text-2xl font-bold mb-6">Other Agents</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {similar.map((a) => (
            <a
              href={`/agents/${a.slug}`}
              class="group surface-card surface-card-hover overflow-hidden"
            >
              <div class="relative aspect-square overflow-hidden">
                <img
                  src={a.imageUrl}
                  alt={a.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent" />
                <div class="absolute bottom-0 left-0 right-0 p-4">
                  <h3 class="text-white font-semibold">{a.name}</h3>
                  <p class="text-white/70 text-sm">{a.title}</p>
                </div>
              </div>
              <div class="p-4">
                <p class="text-sm text-muted">{a.propertiesSold} properties sold</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>
