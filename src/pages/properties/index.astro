---
import Layout from '../../layouts/Layout.astro';
import PropertyCard from '../../components/PropertyCard.vue';
import { properties, filterProperties, searchProperties, formatPrice, getCities, getPropertyTypes } from '../../data/properties';
import type { Property } from '../../data/properties';

const search = Astro.url.searchParams.get('search') || '';
const typeFilter = Astro.url.searchParams.get('type') || '';
const statusFilter = Astro.url.searchParams.get('status') || '';
const cityFilter = Astro.url.searchParams.get('city') || '';
const minPrice = Number(Astro.url.searchParams.get('minPrice')) || 0;
const maxPrice = Number(Astro.url.searchParams.get('maxPrice')) || 0;
const minBedrooms = Number(Astro.url.searchParams.get('minBedrooms')) || 0;

let results: Property[] = search ? searchProperties(search) : properties;

results = filterProperties({
  type: typeFilter || undefined,
  status: statusFilter || undefined,
  minPrice: minPrice || undefined,
  maxPrice: maxPrice || undefined,
  minBedrooms: minBedrooms || undefined,
  city: cityFilter || undefined,
});

const cities = getCities();
const types = getPropertyTypes();
---

<Layout
  title="Properties — LuxEstate"
  description="Browse our curated collection of exceptional properties worldwide. Filter by location, type, price, and more."
>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-10">
      <span class="badge-soft mb-4">Browse Listings</span>
      <h1 class="text-4xl font-semibold">Properties</h1>
      <p class="text-muted mt-3">Browse our curated collection of {properties.length} exceptional properties</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <aside class="lg:col-span-1">
        <form method="GET" class="space-y-4 surface-card p-6 sticky top-28">
          <div>
            <label for="search" class="block text-sm font-medium mb-1.5">Search</label>
            <input
              type="text"
              id="search"
              name="search"
              value={search}
              placeholder="City, location, keyword..."
              class="input-field"
            />
          </div>

          <div>
            <label for="type" class="block text-sm font-medium mb-1.5">Property Type</label>
            <select id="type" name="type" class="input-field">
              <option value="">All Types</option>
              <option value="villa" selected={typeFilter === 'villa'}>Villa</option>
              <option value="house" selected={typeFilter === 'house'}>House</option>
              <option value="apartment" selected={typeFilter === 'apartment'}>Apartment</option>
              <option value="penthouse" selected={typeFilter === 'penthouse'}>Penthouse</option>
            </select>
          </div>

          <div>
            <label for="status" class="block text-sm font-medium mb-1.5">Listing Type</label>
            <select id="status" name="status" class="input-field">
              <option value="">All</option>
              <option value="sale" selected={statusFilter === 'sale'}>For Sale</option>
              <option value="rent" selected={statusFilter === 'rent'}>For Rent</option>
            </select>
          </div>

          <div>
            <label for="city" class="block text-sm font-medium mb-1.5">City</label>
            <select id="city" name="city" class="input-field">
              <option value="">All Cities</option>
              {cities.map((city) => (
                <option value={city} selected={cityFilter === city}>{city}</option>
              ))}
            </select>
          </div>

          <div>
            <label for="minBedrooms" class="block text-sm font-medium mb-1.5">Min Bedrooms</label>
            <select id="minBedrooms" name="minBedrooms" class="input-field">
              <option value="">Any</option>
              <option value="3" selected={minBedrooms === 3}>3+</option>
              <option value="4" selected={minBedrooms === 4}>4+</option>
              <option value="5" selected={minBedrooms === 5}>5+</option>
              <option value="6" selected={minBedrooms === 6}>6+</option>
            </select>
          </div>

          <button type="submit" class="w-full btn-primary justify-center">
            Apply Filters
          </button>

          <a href="/properties" class="block w-full btn-outline justify-center text-center">
            Clear All
          </a>
        </form>
      </aside>

      <div class="lg:col-span-3">
        {search && (
          <p class="text-sm text-muted mb-4">
            {results.length} result{results.length !== 1 ? 's' : ''} for &ldquo;{search}&rdquo;
          </p>
        )}

        {results.length === 0 ? (
          <div class="text-center py-20">
            <p class="text-4xl mb-4">&#x1f3e0;</p>
            <h3 class="text-lg font-semibold">No properties found</h3>
            <p class="text-muted mt-2">Try adjusting your filters or search terms.</p>
          </div>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
            {results.map((property) => (
              <PropertyCard client:load property={property} />
            ))}
          </div>
        )}
      </div>
    </div>
  </section>
</Layout>
