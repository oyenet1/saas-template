---
import Layout from '../layouts/Layout.astro';
import PropertyCard from '../components/PropertyCard.vue';
import HeroSlideshow from '../components/HeroSlideshow.vue';
import AgentCard from '../components/AgentCard.vue';
import TestimonialsCarousel from '../components/TestimonialsCarousel.vue';
import NewsletterForm from '../components/NewsletterForm.vue';
import { getFeaturedProperties } from '../data/properties';
import { getFeaturedAgents } from '../data/agents';
import { testimonies } from '../data/testimonies';

const featured = getFeaturedProperties();
const featuredAgents = getFeaturedAgents();
const stats = [
  { value: '150+', label: 'Properties Sold' },
  { value: '12', label: 'Years Experience' },
  { value: '98%', label: 'Client Satisfaction' },
  { value: '24', label: 'Global Cities' },
];
---

<Layout
  title="Top Villa Luxury Homes — Exceptional Properties Worldwide"
  description="Discover extraordinary real estate. Curated luxury properties in the world's most desirable locations."
>
  <HeroSlideshow client:load />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-24">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 lg:gap-6">
      {stats.map((stat) => (
        <div class="surface-card surface-card-hover text-center p-6 lg:p-8">
          <p class="text-3xl lg:text-4xl font-semibold text-primary font-[family-name:var(--font-display)]">{stat.value}</p>
          <p class="text-sm text-muted mt-2">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-24">
    <div class="grid md:grid-cols-2 gap-8 lg:gap-12">
      <div class="surface-card p-10 lg:p-12">
        <span class="text-4xl mb-4 block">🔭</span>
        <h2 class="text-2xl lg:text-3xl font-semibold">Our Vision</h2>
        <p class="text-muted mt-4 leading-relaxed">
          To redefine luxury living across Africa by curating extraordinary properties
          that blend modern sophistication with our rich cultural heritage.
        </p>
      </div>
      <div class="surface-card p-10 lg:p-12">
        <span class="text-4xl mb-4 block">&#127919;</span>
        <h2 class="text-2xl lg:text-3xl font-semibold">Our Mission</h2>
        <p class="text-muted mt-4 leading-relaxed">
          To provide exceptional real estate services with integrity, expertise,
          and a deep understanding of our clients' dreams — making every transaction
          a seamless, rewarding experience.
        </p>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-24">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
      <div>
        <span class="badge-soft mb-3">Curated Selection</span>
        <h2 class="text-3xl lg:text-4xl font-semibold">Featured Properties</h2>
        <p class="text-muted mt-3 max-w-lg">Hand-picked exceptional listings from our portfolio, vetted by senior advisors.</p>
      </div>
      <a href="/properties" class="inline-flex items-center gap-1 text-sm font-semibold text-primary hover:gap-2 transition-all shrink-0">
        View All
        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {featured.map((property) => (
        <PropertyCard client:load property={property} />
      ))}
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-24">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
      <div>
        <span class="badge-soft mb-3">Our Team</span>
        <h2 class="text-3xl lg:text-4xl font-semibold">Meet Our Agents</h2>
        <p class="text-muted mt-3 max-w-lg">Experienced professionals dedicated to finding your perfect property.</p>
      </div>
      <a href="/agents" class="inline-flex items-center gap-1 text-sm font-semibold text-primary hover:gap-2 transition-all shrink-0">
        View All Agents
        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 lg:gap-6">
      {featuredAgents.map((agent) => (
        <AgentCard client:load agent={agent} />
      ))}
    </div>
  </section>

  <section class="section-muted mt-24 py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="badge-soft mb-4">Client Stories</span>
        <h2 class="text-3xl lg:text-4xl font-semibold">What Our Clients Say</h2>
        <p class="text-muted mt-3 max-w-lg mx-auto">Real stories from real clients who trusted us with their most important asset.</p>
      </div>
      <TestimonialsCarousel client:load testimonials={testimonies} />
    </div>
  </section>

  <section class="section-muted mt-24 py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="badge-soft mb-4">Stay Updated</span>
      <h2 class="text-3xl lg:text-4xl font-semibold">Get Exclusive Updates</h2>
      <p class="text-muted mt-3 mb-8 max-w-lg mx-auto">Be the first to know about new luxury listings, market insights, and exclusive off-market opportunities.</p>
      <NewsletterForm client:load />
    </div>
  </section>

  <section class="mt-24 py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="surface-card overflow-hidden shadow-[var(--shadow-card)]">
        <div class="grid md:grid-cols-2">
          <div class="p-10 lg:p-16 flex flex-col justify-center">
            <span class="badge-soft mb-4 w-fit">Personal Service</span>
            <h2 class="text-3xl lg:text-4xl font-semibold">Ready to Find Your Dream Home?</h2>
            <p class="mt-5 text-muted leading-relaxed">
              Our team of experienced agents is ready to guide you through every step of your real estate journey — whether you're buying, selling, or investing.
            </p>
            <div class="mt-8 flex flex-wrap gap-4">
              <a href="/contact" class="btn-primary">
                Contact an Agent
              </a>
              <a href="/properties" class="btn-outline">
                Browse Listings
              </a>
            </div>
          </div>
          <div class="relative min-h-[320px] lg:min-h-full">
            <img
              src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=800&q=80"
              alt="Luxury interior"
              class="absolute inset-0 w-full h-full object-cover"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-r from-white/20 to-transparent dark:from-[var(--surface-page)]/20" />
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
