---
import ForgotPasswordForm from '../components/ForgotPasswordForm.vue'
import Layout from '../layouts/Layout.astro'
---

<Layout title="Forgot Password — Top Villa Luxury Homes" description="Reset your password">
  <section class="max-w-lg mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-semibold">Forgot your password?</h1>
      <p class="text-muted text-sm mt-2">Enter your email and we'll send a reset code.</p>
    </div>
    <div class="p-6 sm:p-8 rounded-2xl border border-default bg-elevated shadow-[var(--shadow-card)]">
      <ForgotPasswordForm client:load />
    </div>
  </section>
</Layout>
