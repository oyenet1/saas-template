---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.vue';
---

<Layout
  title="Contact Us — LuxEstate"
  description="Get in touch with LuxEstate. Our team of luxury property experts is ready to assist you with buying, selling, or investing in exceptional real estate worldwide."
>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-10">
      <span class="badge-soft mb-4">
        Get in Touch
      </span>
      <h1 class="text-4xl lg:text-5xl font-semibold">Contact Our Team</h1>
      <p class="mt-4 text-lg text-muted max-w-2xl leading-relaxed">
        Whether you're looking to buy your dream home, sell a property, or explore investment opportunities,
        our expert advisors are here to help.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2">
        <div class="surface-card p-6 sm:p-8">
          <h2 class="text-xl font-semibold mb-6">Send Us a Message</h2>
          <ContactForm client:load />
        </div>
      </div>

      <aside class="space-y-6">
        <div class="surface-card p-6">
          <h3 class="font-semibold mb-4">Our Offices</h3>
          <div class="space-y-4">
            <div>
              <p class="text-sm font-medium">Beverly Hills (Headquarters)</p>
              <p class="text-xs text-muted mt-1">456 N Rodeo Drive<br />Beverly Hills, CA 90210</p>
              <p class="text-xs text-muted mt-1">+1 (310) 555-0199</p>
            </div>
            <div class="pt-3 border-t border-default">
              <p class="text-sm font-medium">New York</p>
              <p class="text-xs text-muted mt-1">789 Park Avenue, 14th Floor<br />New York, NY 10021</p>
              <p class="text-xs text-muted mt-1">+1 (212) 555-0188</p>
            </div>
            <div class="pt-3 border-t border-default">
              <p class="text-sm font-medium">London</p>
              <p class="text-xs text-muted mt-1">12 Berkeley Square<br />Mayfair, London W1J 6BS</p>
              <p class="text-xs text-muted mt-1">+44 20 7946 0188</p>
            </div>
          </div>
        </div>

        <div class="surface-card p-6">
          <h3 class="font-semibold mb-3">Contact Info</h3>
          <dl class="space-y-3 text-sm">
            <div>
              <dt class="text-muted text-xs mb-0.5">Email</dt>
              <dd>hello@luxestate.com</dd>
            </div>
            <div>
              <dt class="text-muted text-xs mb-0.5">Phone</dt>
              <dd>+1 (310) 555-0199</dd>
            </div>
            <div>
              <dt class="text-muted text-xs mb-0.5">Hours</dt>
              <dd>Mon–Fri 9 AM – 7 PM<br />Sat 10 AM – 4 PM</dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </section>
</Layout>
