---
import ResetPasswordForm from '../components/ResetPasswordForm.vue'
import Layout from '../layouts/Layout.astro'
---

<Layout title="Reset Password — Top Villa Luxury Homes" description="Choose a new password for your account">
  <section class="max-w-lg mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-semibold">Set a new password</h1>
      <p class="text-muted text-sm mt-2">Enter the reset code from your email and choose a new password.</p>
    </div>
    <div class="p-6 sm:p-8 rounded-2xl border border-default bg-elevated shadow-[var(--shadow-card)]">
      <ResetPasswordForm client:load />
    </div>
  </section>
</Layout>
