---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { properties, formatPrice } from '../../data/properties';

const stats = [
  { label: 'Saved Properties', value: '12', change: '+3 this week' },
  { label: 'Inquiries Sent', value: '8', change: '2 pending reply' },
  { label: 'Viewings Scheduled', value: '3', change: 'Next: Tomorrow 2PM' },
  { label: 'Favorites', value: '24', change: '5 new listings' },
];

const recentActivity = [
  { action: 'Saved', property: 'Sunset Villa Malibu', time: '2 hours ago', slug: 'sunset-villa-malibu' },
  { action: 'Inquired', property: 'Manhattan Sky Penthouse', time: 'Yesterday', slug: 'manhattan-sky-penthouse' },
  { action: 'Viewed', property: 'Dubai Palm Jumeirah Villa', time: '2 days ago', slug: 'dubai-palm-jumeirah-villa' },
  { action: 'Saved', property: 'Parisian Marais Loft', time: '3 days ago', slug: 'parisian-marais-loft' },
  { action: 'Inquired', property: 'Tuscan Hills Estate', time: '1 week ago', slug: 'tuscan-hills-estate' },
];

const savedProperties = properties.slice(0, 4);
---

<DashboardLayout title="Dashboard — LuxEstate" description="Your personal LuxEstate dashboard">
  <div class="mb-8">
    <h1 class="text-2xl font-bold">Welcome back, Alex</h1>
    <p class="text-muted text-sm mt-1">Here's what's happening with your real estate journey.</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    {stats.map((stat) => (
      <div class="p-5 rounded-xl border border-default bg-elevated">
        <p class="text-2xl font-bold">{stat.value}</p>
        <p class="text-xs text-muted mt-0.5">{stat.label}</p>
        <p class="text-xs text-primary mt-2">{stat.change}</p>
      </div>
    ))}
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <div class="p-6 rounded-xl border border-default bg-elevated">
      <h2 class="font-semibold mb-4">Recent Activity</h2>
      <div class="space-y-4">
        {recentActivity.map((item) => (
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
              {item.action === 'Saved' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
              )}
              {item.action === 'Inquired' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              )}
              {item.action === 'Viewed' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
              )}
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm"><span class="font-medium">{item.action}</span> <a href={`/properties/${item.slug}`} class="text-primary hover:underline">{item.property}</a></p>
              <p class="text-xs text-muted">{item.time}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="p-6 rounded-xl border border-default bg-elevated">
      <h2 class="font-semibold mb-4">Saved Properties</h2>
      <div class="space-y-4">
        {savedProperties.map((p) => (
          <a href={`/properties/${p.slug}`} class="flex items-center gap-3 group">
            <img src={p.images[0]} alt={p.title} class="w-16 h-12 rounded-lg object-cover shrink-0" loading="lazy" />
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium group-hover:text-primary transition-colors truncate">{p.title}</p>
              <p class="text-xs text-muted">{p.location}</p>
              <p class="text-xs font-semibold text-primary mt-0.5">{formatPrice(p.price, p.status)}</p>
            </div>
          </a>
        ))}
      </div>
      <a href="/dashboard/saved" class="mt-4 inline-block text-sm text-primary hover:underline">View all saved &rarr;</a>
    </div>
  </div>

  <div class="p-6 rounded-xl border border-default bg-elevated">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-semibold">Market Insights</h2>
      <span class="text-xs text-muted">Updated daily</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      <div>
        <p class="text-sm text-muted">Median Price (Luxury)</p>
        <p class="text-xl font-bold mt-1">$4.8M</p>
        <p class="text-xs text-success mt-1">&uarr; 3.2% this month</p>
      </div>
      <div>
        <p class="text-sm text-muted">Avg. Days on Market</p>
        <p class="text-xl font-bold mt-1">42</p>
        <p class="text-xs text-success mt-1">&darr; 5 days YoY</p>
      </div>
      <div>
        <p class="text-sm text-muted">Active Listings</p>
        <p class="text-xl font-bold mt-1">1,247</p>
        <p class="text-xs text-error mt-1">&darr; 8% YoY</p>
      </div>
    </div>
  </div>
</DashboardLayout>
