---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { properties, formatPrice } from '../../data/properties';
import PropertyCard from '../../components/PropertyCard.vue';

const saved = properties.slice(0, 6);
---

<DashboardLayout title="Saved Properties — LuxEstate" description="Your saved properties">
  <div class="mb-8">
    <h1 class="text-2xl font-bold">Saved Properties</h1>
    <p class="text-muted text-sm mt-1">You have {saved.length} saved properties.</p>
  </div>

  <div class="space-y-4">
    {saved.map((p) => (
      <a href={`/properties/${p.slug}`} class="flex items-center gap-4 p-4 rounded-xl border border-default bg-elevated hover:bg-elevated/80 transition-colors group">
        <img src={p.images[0]} alt={p.title} class="w-24 h-16 rounded-lg object-cover shrink-0" loading="lazy" />
        <div class="flex-1 min-w-0">
          <h3 class="font-medium group-hover:text-primary transition-colors truncate">{p.title}</h3>
          <p class="text-xs text-muted">{p.location}</p>
          <div class="flex items-center gap-3 mt-2 text-xs text-muted">
            <span>{p.bedrooms} beds</span>
            <span>{p.bathrooms} baths</span>
            <span>{p.area.toLocaleString()} sqft</span>
          </div>
        </div>
        <div class="text-right shrink-0">
          <p class="font-semibold text-primary">{formatPrice(p.price, p.status)}</p>
          <p class="text-xs text-muted mt-0.5">{p.status === 'sale' ? 'For Sale' : 'For Rent'}</p>
        </div>
      </a>
    ))}
  </div>
</DashboardLayout>
