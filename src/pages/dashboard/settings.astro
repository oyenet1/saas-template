---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Settings — LuxEstate" description="Account settings">
  <div class="mb-8">
    <h1 class="text-2xl font-bold">Settings</h1>
    <p class="text-muted text-sm mt-1">Manage your account settings and preferences.</p>
  </div>

  <div class="space-y-6 max-w-2xl">
    <div class="p-6 rounded-xl border border-default bg-elevated">
      <h2 class="font-semibold mb-4">Notification Settings</h2>
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <div><p class="text-sm font-medium">Email Alerts</p><p class="text-xs text-muted">New property notifications</p></div>
          <div class="w-10 h-6 rounded-full bg-primary cursor-pointer relative"><div class="w-4 h-4 rounded-full bg-white absolute top-1 right-1 shadow-sm" /></div>
        </div>
        <div class="flex items-center justify-between">
          <div><p class="text-sm font-medium">SMS Alerts</p><p class="text-xs text-muted">Price drop and offer updates</p></div>
          <div class="w-10 h-6 rounded-full bg-muted cursor-pointer relative"><div class="w-4 h-4 rounded-full bg-white absolute top-1 left-1 shadow-sm" /></div>
        </div>
        <div class="flex items-center justify-between">
          <div><p class="text-sm font-medium">Weekly Digest</p><p class="text-xs text-muted">Weekly market insights email</p></div>
          <div class="w-10 h-6 rounded-full bg-primary cursor-pointer relative"><div class="w-4 h-4 rounded-full bg-white absolute top-1 right-1 shadow-sm" /></div>
        </div>
      </div>
    </div>

    <div class="p-6 rounded-xl border border-default bg-elevated">
      <h2 class="font-semibold mb-4">Privacy</h2>
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <div><p class="text-sm font-medium">Profile Visibility</p><p class="text-xs text-muted">Show my profile to agents</p></div>
          <div class="w-10 h-6 rounded-full bg-primary cursor-pointer relative"><div class="w-4 h-4 rounded-full bg-white absolute top-1 right-1 shadow-sm" /></div>
        </div>
        <div class="flex items-center justify-between">
          <div><p class="text-sm font-medium">Activity Status</p><p class="text-xs text-muted">Show when I'm active</p></div>
          <div class="w-10 h-6 rounded-full bg-muted cursor-pointer relative"><div class="w-4 h-4 rounded-full bg-white absolute top-1 left-1 shadow-sm" /></div>
        </div>
      </div>
    </div>

    <div class="p-6 rounded-xl border border-default bg-elevated">
      <h2 class="font-semibold mb-4">Account</h2>
      <div class="space-y-3">
        <button type="button" class="w-full px-4 py-2.5 rounded-lg border border-default text-sm font-medium hover:bg-elevated transition-colors text-left">Change Password</button>
        <button type="button" class="w-full px-4 py-2.5 rounded-lg border border-default text-sm font-medium hover:bg-elevated transition-colors text-left">Download My Data</button>
        <button type="button" class="w-full px-4 py-2.5 rounded-lg border border-error/30 text-error text-sm font-medium hover:bg-error/5 transition-colors text-left">Delete Account</button>
      </div>
    </div>
  </div>
</DashboardLayout>
