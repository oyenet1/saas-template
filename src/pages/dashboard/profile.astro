---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ProfileForm from '../../components/ProfileForm.vue';
---

<DashboardLayout title="Profile — LuxEstate" description="Manage your LuxEstate profile">
  <div class="mb-8">
    <h1 class="text-2xl font-bold">Profile</h1>
    <p class="text-muted text-sm mt-1">Manage your personal information and preferences.</p>
  </div>

  <div class="space-y-6">
    <ProfileForm client:load />

    <div class="surface-card p-6">
      <h2 class="font-semibold mb-4">Saved Searches</h2>
      <div class="space-y-3">
        <div class="flex items-center justify-between p-3 rounded-lg border border-default">
          <div>
            <p class="text-sm font-medium">Los Angeles Luxury Villas</p>
            <p class="text-xs text-muted">5+ beds, pool, ocean view &bull; 3 new listings</p>
          </div>
          <UButton to="#" variant="link" color="primary" size="sm" trailing-icon="i-lucide-arrow-right" label="View" />
        </div>
        <div class="flex items-center justify-between p-3 rounded-lg border border-default">
          <div>
            <p class="text-sm font-medium">Manhattan Penthouses</p>
            <p class="text-xs text-muted">4+ beds, terrace, Central Park view &bull; 1 new listing</p>
          </div>
          <UButton to="#" variant="link" color="primary" size="sm" trailing-icon="i-lucide-arrow-right" label="View" />
        </div>
        <div class="flex items-center justify-between p-3 rounded-lg border border-default">
          <div>
            <p class="text-sm font-medium">European Waterfront</p>
            <p class="text-xs text-muted">Lake Como, Côte d'Azur, Amalfi &bull; 6 new listings</p>
          </div>
          <UButton to="#" variant="link" color="primary" size="sm" trailing-icon="i-lucide-arrow-right" label="View" />
        </div>
      </div>
      <UButton
        to="#"
        variant="link"
        color="primary"
        size="sm"
        leading-icon="i-lucide-plus"
        label="New Saved Search"
        class="mt-4 px-0"
      />
    </div>
  </div>
</DashboardLayout>
