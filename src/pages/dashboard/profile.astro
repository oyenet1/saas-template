---
export const prerender = false;

import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ProfileForm from '../../components/ProfileForm.vue';
---

<DashboardLayout title="Profile — LuxEstate" description="Manage your LuxEstate profile">
  <div class="mb-8">
    <h1 class="text-2xl font-bold">Profile</h1>
    <p class="text-muted text-sm mt-1">Manage your personal information and preferences.</p>
  </div>

  <div class="space-y-6">
    <ProfileForm client:load />

    <div class="surface-card p-6">
      <h2 class="font-semibold mb-4">Saved Searches</h2>
      <div class="space-y-3">
        <div class="flex items-center justify-between p-3 rounded-lg border border-default">
          <div>
            <p class="text-sm font-medium">Los Angeles Luxury Villas</p>
            <p class="text-xs text-muted">5+ beds, pool, ocean view &bull; 3 new listings</p>
          </div>
          <a href="#" class="text-sm font-semibold text-primary hover:text-primary/80 transition-colors inline-flex items-center gap-1">
            View
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
        <div class="flex items-center justify-between p-3 rounded-lg border border-default">
          <div>
            <p class="text-sm font-medium">Manhattan Penthouses</p>
            <p class="text-xs text-muted">4+ beds, terrace, Central Park view &bull; 1 new listing</p>
          </div>
          <a href="#" class="text-sm font-semibold text-primary hover:text-primary/80 transition-colors inline-flex items-center gap-1">
            View
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
        <div class="flex items-center justify-between p-3 rounded-lg border border-default">
          <div>
            <p class="text-sm font-medium">European Waterfront</p>
            <p class="text-xs text-muted">Lake Como, Côte d'Azur, Amalfi &bull; 6 new listings</p>
          </div>
          <a href="#" class="text-sm font-semibold text-primary hover:text-primary/80 transition-colors inline-flex items-center gap-1">
            View
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
      <a href="#" class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:text-primary/80 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        New Saved Search
      </a>
    </div>
  </div>
</DashboardLayout>
