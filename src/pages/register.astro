---
import RegisterForm from '../components/RegisterForm.vue'
import Layout from '../layouts/Layout.astro'
import { getSessionUser } from '../lib/auth-client'

const user = await getSessionUser(Astro.request)
if (user) {
  return Astro.redirect('/dashboard')
}

const next = Astro.url.searchParams.get('next') ?? undefined
---

<Layout title="Create Account — Top Villa Luxury Homes" description="Create your account">
  <section class="max-w-md mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-semibold">Create your account</h1>
      <p class="text-muted text-sm mt-2">A few details and you're in. We never share your email.</p>
    </div>
    <div class="p-6 sm:p-8 rounded-2xl border border-default bg-elevated shadow-[var(--shadow-card)]">
      <RegisterForm client:load next={next} />
    </div>
  </section>
</Layout>
